 static int forward_argc;
 static char **forward_argv;
 static int exit_status;
+static UIWindowScene *activeWindowScene;
+
+static BOOL UIKit_UsesScenes(void)
+{
+    return [[NSBundle mainBundle] objectForInfoDictionaryKey:@"UIApplicationSceneManifest"] != nil;
+}
+
+UIWindowScene *UIKit_GetActiveWindowScene(void)
+{
+    return activeWindowScene;
+}
+
+UIScreen *UIKit_GetMainScreen(void)
+{
+    if (activeWindowScene != nil) {
+        return activeWindowScene.screen;
+    }
+    return [UIScreen mainScreen];
+}
+
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(void)
+{
+#if TARGET_OS_TV
+    return UIInterfaceOrientationLandscapeLeft;
+#else
+    if (activeWindowScene != nil) {
+        return activeWindowScene.interfaceOrientation;
+    }
+    return [UIApplication sharedApplication].statusBarOrientation;
+#endif
+}
+
+UIWindow *UIKit_CreateUIWindow(Class windowClass, UIScreen *screen)
+{
+    UIWindowScene *scene = activeWindowScene;
+    /* A window outside the scene is never shown. */
+    if (scene != nil && screen == scene.screen) {
+        return [[windowClass alloc] initWithWindowScene:scene];
+    }
+    return [[windowClass alloc] initWithFrame:screen.bounds];
+}
 
