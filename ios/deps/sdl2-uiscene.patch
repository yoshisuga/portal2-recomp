+/* UIScene lifecycle (required by apps linked against the iOS 27 SDK): used
+ * when Info.plist has a UIApplicationSceneManifest naming this class. SDL's
+ * main starts once the window scene connects, and SDL's UIWindows are created
+ * in that scene. */
+@interface SDLUIKitSceneDelegate : UIResponder<UIWindowSceneDelegate>
+
+@property (nonatomic) UIWindow *window;
+
+@end
+
+/* The connected window scene, or nil (no scene manifest, or not yet connected). */
+UIWindowScene *UIKit_GetActiveWindowScene(void);
+
+/* A new window of the given UIWindow class, in the active window scene when
+ * there is one (and it is on the given screen), else sized to the screen. */
+UIWindow *UIKit_CreateUIWindow(Class windowClass, UIScreen *screen);
+
+/* The screen SDL treats as the main one: the window scene's when there is one
+ * ([UIScreen mainScreen] can be another display, sized differently). */
+UIScreen *UIKit_GetMainScreen(void);
+
+/* The interface orientation: the window scene's when there is one (the status
+ * bar orientation is not kept up to date with scenes). */
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(void);
+
