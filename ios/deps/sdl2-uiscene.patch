+@implementation SDLUIKitSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    /* One window scene (UIApplicationSupportsMultipleScenes is off). */
+    if (![scene isKindOfClass:[UIWindowScene class]] || activeWindowScene != nil) {
+        return;
+    }
+    activeWindowScene = (UIWindowScene *)scene;
+    [[SDLUIKitDelegate sharedAppDelegate] startMain];
+}
+
+- (void)windowScene:(UIWindowScene *)windowScene didUpdateCoordinateSpace:(id<UICoordinateSpace>)previousCoordinateSpace interfaceOrientation:(UIInterfaceOrientation)previousInterfaceOrientation traitCollection:(UITraitCollection *)previousTraitCollection
+{
+    /* With scenes, UIApplicationDidChangeStatusBarOrientationNotification is
+     * not posted: rotations are reported here. */
+    if (windowScene == activeWindowScene && windowScene.interfaceOrientation != previousInterfaceOrientation &&
+        SDL_GetVideoDevice() != NULL) {
+        SDL_OnApplicationDidChangeStatusBarOrientation();
+    }
+}
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == activeWindowScene) {
+        activeWindowScene = nil;
+    }
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+    for (UIOpenURLContext *context in URLContexts) {
+        [[SDLUIKitDelegate sharedAppDelegate] sendDropFileForURL:context.URL];
+    }
+}
+
+- (UIWindow *)window
+{
+    return [[SDLUIKitDelegate sharedAppDelegate] window];
+}
+
+- (void)setWindow:(UIWindow *)window
+{
+    /* Do nothing: the window is SDL's. */
+}
+
+@end
+
 #endif /* SDL_VIDEO_DRIVER_UIKIT */
 
