+// iOS (Half-Life 2) : OpenGL ES 3.0 n'a pas de « base vertex ». Plutôt que de
+// recopier les indices sur le CPU (indices en mémoire client : le pilote les
+// parcourt et les recopie à chaque tracé, l'essentiel du temps du thread
+// principal), on décale l'origine de chaque attribut de basevertex sommets et
+// on trace avec les indices d'origine, restés dans leur tampon GPU. Seulement
+// si les indices et tous les attributs actifs sont dans de vrais tampons.
+static int basevertex_refused(GLint basevertex) {
+    if(!glstate->vao->elements) return 1;
+    if(!glstate->vao->elements->real_buffer) return 2;
+    if(glstate->list.active || glstate->list.pending) return 3;
+    if(glstate->polygon_mode == GL_LINE || glstate->polygon_mode == GL_POINT) return 4;
+    for(int i=0; i<hardext.maxvattrib; i++) {
+        vertexattrib_t *w = &glstate->vao->vertexattrib[i];
+        if(!w->enabled || w->divisor) continue;
+        if(!w->real_buffer) return 5;
+        if((intptr_t)w->real_pointer + (intptr_t)basevertex * w->stride < 0) return 6;
+    }
+    return 0;
+}
+static int basevertex_shift(GLint basevertex, int sign) {
+    if(sign > 0) {
+        static unsigned counts[7], total;
+        static int trace = -1;
+        if(trace < 0) trace = getenv("P2_IOS_BASEVERTEX_TRACE") != NULL;
+        int why = basevertex_refused(basevertex);
+        ++counts[why];
+        if(trace && ++total % 5000 == 0)
+            fprintf(stderr, "[basevertex] décalés %u, refus : sans indices %u, indices en RAM %u, liste %u, polygone %u, attribut en RAM %u, négatif %u\n",
+                    counts[0], counts[1], counts[2], counts[3], counts[4], counts[5], counts[6]);
+        if(trace) {   // formats d'attributs distincts
+            static struct { int i, size, normalized, stride, align; GLenum type; } seen[96]; static int nseen;
+            for(int i=0; i<hardext.maxvattrib; i++) {
+                vertexattrib_t *w = &glstate->vao->vertexattrib[i];
+                if(!w->enabled || w->divisor) continue;
+                int align = (int)(((intptr_t)w->real_pointer + (intptr_t)basevertex * w->stride) & 3);
+                int known = 0;
+                for(int k=0; k<nseen && !known; k++)
+                    known = seen[k].i==i && seen[k].size==w->size && seen[k].type==w->type && seen[k].normalized==w->normalized
+                            && seen[k].stride==w->stride && seen[k].align==align;
+                if(!known && nseen < 96) {
+                    seen[nseen].i=i; seen[nseen].size=w->size; seen[nseen].type=w->type; seen[nseen].normalized=w->normalized;
+                    seen[nseen].stride=w->stride; seen[nseen++].align=align;
+                    fprintf(stderr, "[attrib] %d : taille %d type %#x normalisé %d pas %d décalage%%4 %d\n", i, w->size, w->type,
+                            w->normalized, w->stride, align);
+                }
+            }
+        }
+        if(why) return 0;
+    }
+    for(int i=0; i<hardext.maxvattrib; i++) {
+        vertexattrib_t *w = &glstate->vao->vertexattrib[i];
+        if(!w->enabled || w->divisor) continue;
+        // Flux qui se chevauche (pas plus petit qu'un élément) : valeur constante
+        // de togl pour une entrée absente, dans un petit tampon. Décalé, il lisait
+        // au-delà de ce tampon (des milliers de sommets plus loin) : attribut
+        // aléatoire, couleurs saturées selon l'exécution. Laissé en place.
+        if(w->stride < (w->size==GL_BGRA ? 4 : w->size)*gl_sizeof(w->type)) continue;
+        intptr_t delta = (intptr_t)sign * basevertex * w->stride;
+        w->real_pointer = (const char*)w->real_pointer + delta;
+        w->pointer = (const char*)w->pointer + delta;
+    }
+    return 1;
+}
